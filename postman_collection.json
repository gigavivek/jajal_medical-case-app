{
  "info": {
    "name": "Jajal Medical Case Management API",
    "description": "Postman / Thunder Client collection for Jajal Medical Case Management REST API with Laravel Sanctum.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@jajalmedical.com\",\n  \"password\": \"Admin@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "login"]
        }
      }
    },
    {
      "name": "2. Login (Viewer)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"viewer@jajalmedical.com\",\n  \"password\": \"Viewer@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "login"]
        }
      }
    },
    {
      "name": "3. List Cases (Paginated)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases?page=1&per_page=10&search=&status=",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cases"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "per_page", "value": "10" },
            { "key": "search", "value": "" },
            { "key": "status", "value": "" }
          ]
        }
      }
    },
    {
      "name": "4. Create Case (Admin Only)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"case_number\": \"CASE-9999\",\n  \"patient_reference\": \"JM-PT-99999\",\n  \"surgeon_name\": \"Dr. Rajesh Jajal, MD\",\n  \"implant_type\": \"Patient-Specific 3D Cranial Titanium Mesh\",\n  \"status\": \"Planning\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-11-20\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cases",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cases"]
        }
      }
    },
    {
      "name": "5. Get Single Case",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cases", "1"]
        }
      }
    },
    {
      "name": "6. Update Case (Admin Only)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"case_number\": \"CASE-1001\",\n  \"patient_reference\": \"JM-PT-88201\",\n  \"surgeon_name\": \"Dr. Rajesh Jajal, MD\",\n  \"implant_type\": \"Titanium 3D-Printed Cranial Mesh (Frontal Defect)\",\n  \"status\": \"In Review\",\n  \"priority\": \"High\",\n  \"surgery_date\": \"2026-11-25\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cases/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cases", "1"]
        }
      }
    },
    {
      "name": "7. Delete Case (Admin Only)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cases", "1"]
        }
      }
    },
    {
      "name": "8. Logout (Revoke Token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "logout"]
        }
      }
    }
  ]
}